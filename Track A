import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import ttest_ind
import re
import textwrap

# --- Configuration & Constants ---
FILE_PATH = "PCR_NGS_Data.xlsx"
OUTPUT_FILE_SIGNIFICANT = "NGS_species_summary_significant.xlsx"
P_VALUE_THRESHOLD = 0.05
GROUP_COLUMN = "Halitosis"
FEATURE_PREFIX = "NGS__"

def load_and_preprocess_data(file_path: str, skip_rows: int = 6) -> pd.DataFrame:

    print("1. load data...")
    df = pd.read_excel(file_path, skiprows=skip_rows)

    raw_ngs_cols = [c for c in df.columns if c.startswith("__") and c != "__"]

    base_names = pd.Series(raw_ngs_cols).str.replace(r'\.\d+$', '', regex=True)

    for base_name in base_names.unique():
        cols_to_sum = [col for col in raw_ngs_cols if re.sub(r'\.\d+$', '', col) == base_name]
        new_col_name = f"NGS{base_name}"
        df[new_col_name] = df[cols_to_sum].sum(axis=1)

    df.drop(columns=raw_ngs_cols, inplace=True)
    print("데이터 로드 및 전처리 완료.")
    return df

def perform_welch_t_test(df: pd.DataFrame, group_col: str, feature_prefix: str) -> pd.DataFrame:

    print("2. Welch's t-test...")
    species_vars = [col for col in df.columns if col.startswith(feature_prefix)]

    group0_df = df[df[group_col] == 0]
    group1_df = df[df[group_col] == 1]

    results = []
    for var in species_vars:
        data0 = group0_df[var].dropna()
        data1 = group1_df[var].dropna()

        if len(data0) < 2 or len(data1) < 2:
            p_value = np.nan
        elif np.var(data0, ddof=0) == 0 and np.var(data1, ddof=0) == 0:
            p_value = 1.0 if data0.mean() == data1.mean() else 0.0
        else:
            _, p_value = ttest_ind(data0, data1, equal_var=False)

        results.append({
            "Species": var,
            "Non-Halitosis_Mean": data0.mean(),
            "Non-Halitosis_Std": data0.std(),
            "Halitosis_Mean": data1.mean(),
            "Halitosis_Std": data1.std(),
            "P-value": p_value
        })

    print("t-test is done.")
    return pd.DataFrame(results)

def shorten_species_name(full_name: str) -> str:
    s = full_name.replace(FEATURE_PREFIX, "").replace("[", "").replace("]", "")
    parts = s.split()
    return f"{parts[0][0]}. {' '.join(parts[1:])}" if len(parts) >= 2 else s

def plot_radial_abundance(df: pd.DataFrame, p_value_threshold: float):

    print("3. Radial plot...")
    plot_df = df[df['P-value'] < p_value_threshold].copy()
    plot_df['Short_Name'] = plot_df['Species'].apply(shorten_species_name)
    plot_df.sort_values("Species", inplace=True)

    n_species = len(plot_df)
    if n_species == 0:
        print("No data.")
        return

    # Normalize
    non_hal_means = plot_df["Non-Halitosis_Mean"].values
    hal_means = plot_df["Halitosis_Mean"].values
    denom = np.maximum(non_hal_means, hal_means)
    denom[denom == 0] = 1 

    non_norm = non_hal_means / denom
    hal_norm = hal_means / denom

    # Plot
    theta = np.linspace(0, 2 * np.pi, n_species, endpoint=False)
    bar_width = (2 * np.pi / n_species) * 0.9
    inner_radius = 5.0
    bar_height = inner_radius * 0.3

    colors = plt.cm.get_cmap("tab20", n_species)
    color_map = {species: colors(i) for i, species in enumerate(plot_df["Species"])}

    fig, axes = plt.subplots(1, 2, figsize=(16, 8), subplot_kw=dict(projection="polar"))
    fig.subplots_adjust(wspace=0.35)

    plot_data = {
        "Non-Halitosis": non_norm,
        "Halitosis": hal_norm,
    }

    for ax, (title, data) in zip(axes, plot_data.items()):
        ax.set_theta_zero_location("N")
        ax.set_theta_direction(-1)
        ax.set_ylim(0, inner_radius + bar_height * 1.6)
        ax.grid(False)
        ax.tick_params(labelleft=False)
        ax.spines['polar'].set_visible(False)
        ax.set_xticks([])
        ax.set_title(title, y=1.10, fontsize=14, weight='bold')

        ax.bar(theta, data * bar_height, width=bar_width, bottom=inner_radius,
               color=[color_map[s] for s in plot_df["Species"]], edgecolor="white", linewidth=0.5)

        for th, label_text in zip(theta, plot_df["Short_Name"]):
            ax.text(th, inner_radius + bar_height * 1.4,
                    textwrap.shorten(label_text, 25, placeholder='…'),
                    ha='center', va='center', fontsize=11, fontstyle='italic')

    handles = [plt.Rectangle((0,0),1,1, color=color_map[s], label=l) for s, l in zip(plot_df["Species"], plot_df["Short_Name"])]
    fig.legend(handles=handles, loc="lower center", bbox_to_anchor=(0.5, -0.5),
               ncol=min(6, n_species), fontsize=11, frameon=False)

    fig.suptitle("Species Abundance (Normalized within each species)", fontsize=16, y=1.02)
    plt.tight_layout(rect=[0, 0.05, 1, 0.98])
    plt.show()

def plot_abundance_comparison_bar(df: pd.DataFrame, p_value_threshold: float):

    print("4. Bar plot...")
    plot_df = df[
        (df['P-value'] < p_value_threshold) &
        (df["Halitosis_Mean"] > df["Non-Halitosis_Mean"])
    ].copy()

    if plot_df.empty:
        print("No data.")
        return

    plot_df['Short_Name'] = plot_df['Species'].apply(shorten_species_name)
    plot_df.sort_values("Halitosis_Mean", ascending=False, inplace=True)

    n_species = len(plot_df)
    x = np.arange(n_species)
    width = 0.38

    fig, ax = plt.subplots(figsize=(14, 7))

    ax.bar(x - width/2, plot_df["Non-Halitosis_Mean"], width, label="Non-Halitosis", color="#1f77b4")
    ax.bar(x + width/2, plot_df["Halitosis_Mean"], width, label="Halitosis", color="#aec7e8")

    for i, row in plot_df.iterrows():
        ymax = max(row["Halitosis_Mean"], row["Non-Halitosis_Mean"])
        ax.text(x[plot_df.index.get_loc(i)], ymax * 1.03, f"p={row['P-value']:.2g}",
                ha="center", va="bottom", fontsize=9, weight='bold')

    ax.set_ylabel("Mean Abundance")
    ax.set_title("Comparison of Mean Abundance between Halitosis and Non-halitosis Groups")
    ax.set_xticks(x)
    ax.set_xticklabels(plot_df["Short_Name"], rotation=45, ha='right')
    ax.legend(frameon=False)
    ax.margins(y=0.15)
    ax.grid(axis='y', linestyle='--', alpha=0.4)

    plt.tight_layout()
    plt.show()

# --- Main Execution ---
if __name__ == "__main__":

    processed_df = load_and_preprocess_data(FILE_PATH)
    analysis_results_df = perform_welch_t_test(processed_df, GROUP_COLUMN, FEATURE_PREFIX)

    significant_df = analysis_results_df[analysis_results_df['P-value'] < P_VALUE_THRESHOLD]
    significant_df.to_excel(OUTPUT_FILE_SIGNIFICANT, index=False)
    print(f"'{OUTPUT_FILE_SIGNIFICANT}' saved")

    plot_radial_abundance(analysis_results_df, P_VALUE_THRESHOLD)
    plot_abundance_comparison_bar(analysis_results_df, P_VALUE_THRESHOLD)
