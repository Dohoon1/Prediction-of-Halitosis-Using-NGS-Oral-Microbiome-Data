import pandas as pd
import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, TensorDataset
from sklearn.model_selection import train_test_split, KFold
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
import re
import os
import seaborn as sns
import matplotlib.pyplot as plt
import networkx as nx

# ===================================================================
# 1. Configuration & Constants
# ===================================================================
FILE_PATH = "PCR_NGS_Data.xlsx"
OUTPUT_DIR = "regression_analysis_original_logic"
TARGET_VARIABLES = ['H2S \n(ppb)', 'CH3SH \n(ppb)', 'VSCs (ppb)']
CORRELATION_THRESHOLD = 0.6

HYPERPARAMS_GRID = {'lr': [0.01, 0.1], 'epochs': [500, 1000]}
BATCH_SIZE = 16
K_FOLDS = 5
RANDOM_STATE = 42
DEVICE = torch.device('cuda:0' if torch.cuda.is_available() else 'cpu')

# ===================================================================
# 2. Model Definition & Helper Functions
# ===================================================================

class RegressionModel(nn.Module):
    def __init__(self, in_dim):
        super().__init__()
        self.linear = nn.Linear(in_dim, 1)
    def forward(self, x):
        return self.linear(x).squeeze(-1)

def shorten_species_name(full_name: str) -> str:
    if not isinstance(full_name, str): return str(full_name)
    s = re.sub(r'^(NGS_MAPPED_)', '', full_name).replace("_", " ")
    parts = s.split()
    if len(parts) >= 2: return f"{parts[0][0].upper()}. {parts[1]}"
    return s if not parts else parts[0]

def load_and_preprocess_data(file_path: str) -> pd.DataFrame:
    """데이터를 로드하고, NGS 데이터를 매핑하며, 새로운 임상/인구통계 변수를 전처리합니다."""
    print("Step 1: 데이터 로드 및 전처리...")
    df = pd.read_excel(file_path, skiprows=6)

    # --- 기존 NGS 데이터 처리 (동일) ---
    raw_ngs_cols = [c for c in df.columns if c.startswith("__") and c != "__"]
    base_names = pd.Series(raw_ngs_cols).str.replace(r'\.\d+$', '', regex=True)
    for base_name in base_names.unique():
        cols_to_sum = [col for col in raw_ngs_cols if re.sub(r'\.\d+$', '', col) == base_name]
        df[f"NGS{base_name}"] = df[cols_to_sum].sum(axis=1)
    df.drop(columns=raw_ngs_cols, inplace=True)

    pcr_species_list = [
        "Aggregatibacter actinomycetemcomitans", "Prevotella intermedia", "Prevotella nigrescens",
        "Lactobacillus casei", "Fusobacterium nucleatum", "Streptococcus mutans",
        "Streptococcus sobrinus", "Treponema denticola", "Porphyromonas gingivalis",
        "Tannerella forsythia", "Eikenella corrodens", "Parvimonas micra",
        "Campylobacter rectus", "Eubacterium nodatum", "Fusobacterium alocis",
        "Porphyromonas endodontalis"
    ]
    ngs_cols = [c for c in df.columns if c.startswith("NGS__")]
    for sp in pcr_species_list:
        matching_cols = [c for c in ngs_cols if sp in c]
        new_col_name = f"NGS_MAPPED_{sp.replace(' ', '_')}"
        df[new_col_name] = df[matching_cols].sum(axis=1) if matching_cols else 0
        if sp in df.columns:
            df.rename(columns={sp: f"PCR_{sp.replace(' ', '_')}"}, inplace=True)

    # --- ✨ [신규] 임상/인구통계 변수 전처리 ---
    print("  > 새로운 변수 전처리 중...")
    # 1. Age는 연속 변수이므로 그대로 사용
    # 2. 범주형 변수들을 원-핫 인코딩으로 변환
    categorical_cols = ['Sex', 'Smoking', 'Oral hygiene']
    df = pd.get_dummies(df, columns=categorical_cols, drop_first=True, dtype=float)
    print(f"  > 원-핫 인코딩 후 생성된 컬럼: {[c for c in df.columns if any(cat in c for cat in categorical_cols)]}")

    return df


# ✅ [수정] 상관관계 분석 대상을 NGS 데이터로 한정
def analyze_and_plot_correlations(df: pd.DataFrame):
    print("\nStep 2: NGS 데이터 상관관계 분석 및 시각화...")
    # 분석할 컬럼을 NGS 데이터로만 한정
    ngs_cols_for_corr = [c for c in df.columns if c.startswith("NGS_MAPPED_")]

    df_0 = df[df["Halitosis"] == 0]
    df_1 = df[df["Halitosis"] == 1]

    corr_matrix_0 = df_0[ngs_cols_for_corr].corr(method='pearson')
    corr_matrix_1 = df_1[ngs_cols_for_corr].corr(method='pearson')

    return corr_matrix_0, corr_matrix_1

def find_and_visualize_groups(corr_matrix_0, corr_matrix_1):
    """상관관계 그룹을 찾고 네트워크 그래프를 시각화합니다."""
    print("\nStep 3: 상관관계 그룹 탐색 및 네트워크 시각화...")
    groups_0 = _find_correlation_groups(corr_matrix_0, CORRELATION_THRESHOLD)
    groups_1 = _find_correlation_groups(corr_matrix_1, CORRELATION_THRESHOLD)

    all_species = set().union(*groups_0, *groups_1)
    species_color_map = dict(zip(sorted(all_species), sns.color_palette('pastel', n_colors=len(all_species))))

    for i, g_set in enumerate(groups_0, 1):
        _draw_group_network(g_set, corr_matrix_0, f"NonHal_Group_{i}", species_color_map)
    for i, g_set in enumerate(groups_1, 1):
        _draw_group_network(g_set, corr_matrix_1, f"Hal_Group_{i}", species_color_map)

    return groups_0, groups_1

def _find_correlation_groups(corr_matrix, threshold):
    """상관계수 행렬에서 그룹을 찾는 내부 함수."""
    G = nx.from_pandas_adjacency(corr_matrix.fillna(0))
    edges_to_remove = [(u, v) for u, v, w in G.edges(data='weight') if abs(w) < threshold]
    G.remove_edges_from(edges_to_remove)
    return [list(c) for c in nx.connected_components(G) if len(c) >= 2]



def _draw_group_network(group_nodes, corr_matrix, title, color_map):
    """그룹 네트워크를 시각화하는 내부 함수."""
    G = nx.Graph()
    nodes = sorted(group_nodes)
    for n in nodes: G.add_node(n, label=shorten_species_name(n))

    for i, n1 in enumerate(nodes):
        for j in range(i + 1, len(nodes)):
            n2 = nodes[j]
            r = corr_matrix.loc[n1, n2]
            if pd.notna(r) and abs(r) >= CORRELATION_THRESHOLD:
                G.add_edge(n1, n2, weight=float(r))

    pos = nx.spring_layout(G, seed=RANDOM_STATE, k=0.5 / np.sqrt(len(nodes)))

    fig, ax = plt.subplots(figsize=(7, 7))
    nx.draw(G, pos, ax=ax, with_labels=False, node_size=[1800 + 180 * len(G.nodes[n]['label']) for n in G.nodes()],
            node_color=[color_map[n] for n in G.nodes()], edge_color='#9e9e9e', width=[abs(G[u][v]['weight']) * 6 for u, v in G.edges()])
    nx.draw_networkx_labels(G, pos, labels={n: G.nodes[n]['label'] for n in G.nodes()}, font_size=11, font_weight='bold')
    nx.draw_networkx_edge_labels(G, pos, edge_labels={(u, v): f"{G[u][v]['weight']:.2f}" for u, v in G.edges()}, font_size=11)

    ax.set_title(title, fontsize=14)
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    plt.savefig(os.path.join(OUTPUT_DIR, f"{title}.png"), dpi=300)
    plt.show()

def run_hyperparameter_tuning_cv(X_train, y_train, features, hyperparams_grid):
    # ... (이전과 동일)
    kf=KFold(n_splits=K_FOLDS,shuffle=True,random_state=RANDOM_STATE); best_params,best_cv_loss=None,float('inf')
    for lr in hyperparams_grid['lr']:
      for epochs in hyperparams_grid['epochs']:
        fold_losses=[]
        for train_idx,val_idx in kf.split(X_train):
          X_tr_fold,X_val_fold=X_train.iloc[train_idx][features],X_train.iloc[val_idx][features]; y_tr_fold,y_val_fold=y_train.iloc[train_idx],y_train.iloc[val_idx]
          scaler=StandardScaler().fit(X_tr_fold); X_tr_s,X_val_s=scaler.transform(X_tr_fold),scaler.transform(X_val_fold)
          train_ds=DataLoader(TensorDataset(torch.tensor(X_tr_s,dtype=torch.float32),torch.tensor(y_tr_fold.values,dtype=torch.float32)),BATCH_SIZE,shuffle=True)
          val_ds=DataLoader(TensorDataset(torch.tensor(X_val_s,dtype=torch.float32),torch.tensor(y_val_fold.values,dtype=torch.float32)),BATCH_SIZE)
          model=RegressionModel(len(features)).to(DEVICE); optimizer,criterion=optim.Adam(model.parameters(),lr=lr),nn.MSELoss()
          for _ in range(epochs):
            model.train()
            for x,y in train_ds: optimizer.zero_grad(); outputs=model(x.to(DEVICE)); loss=criterion(outputs,y.to(DEVICE)); loss.backward(); optimizer.step()
          model.eval(); val_loss=0
          with torch.no_grad():
            for x,y in val_ds: outputs=model(x.to(DEVICE)); loss=criterion(outputs,y.to(DEVICE)); val_loss+=loss.item()*len(x)
          fold_losses.append(val_loss/len(val_ds))
        if np.mean(fold_losses)<best_cv_loss: best_cv_loss,best_params=np.mean(fold_losses),{'lr':lr,'epochs':epochs}
    return best_params

def train_final_regression_model(X_train, y_train, features, best_params):
    # ... (이전과 동일)
    scaler=StandardScaler().fit(X_train[features]); X_tr_s=scaler.transform(X_train[features])
    train_ds=DataLoader(TensorDataset(torch.tensor(X_tr_s,dtype=torch.float32),torch.tensor(y_train.values,dtype=torch.float32)),BATCH_SIZE,shuffle=True)
    final_model=RegressionModel(len(features)).to(DEVICE); optimizer,criterion=optim.Adam(final_model.parameters(),lr=best_params['lr']),nn.MSELoss()
    for _ in range(best_params['epochs']):
      final_model.train()
      for x,y in train_ds: optimizer.zero_grad(); outputs=final_model(x.to(DEVICE)); loss=criterion(outputs,y.to(DEVICE)); loss.backward(); optimizer.step()
    return final_model,scaler

def evaluate_regression_model(model, scaler, X_test, y_test, features):
    # ... (이전과 동일)
    X_te_s = scaler.transform(X_test[features]); model.eval()
    with torch.no_grad(): y_pred=model(torch.tensor(X_te_s,dtype=torch.float32).to(DEVICE)).cpu().numpy()
    r2,mae,rmse=r2_score(y_test,y_pred),mean_absolute_error(y_test,y_pred),np.sqrt(mean_squared_error(y_test,y_pred))
    return {'R_squared': r2, 'MAE': mae, 'RMSE': rmse}

# ===================================================================
# 3. Main Pipeline Execution
# ===================================================================
if __name__ == "__main__":

    # Step 1: 데이터 로드 및 전처리
    analysis_ready_df = load_and_preprocess_data(FILE_PATH)

    # Step 2: NGS 데이터만으로 상관관계 분석
    corr_0, corr_1 = analyze_and_plot_correlations(analysis_ready_df)
    print(analysis_ready_df)

    # Step 3: NGS 데이터만으로 그룹 탐색
    groups_0, groups_1 = find_and_visualize_groups(corr_0, corr_1)

    # Step 4: 학습할 모델 정의 (기존 로직 유지)
    model_definitions = {}
    for i, group in enumerate(groups_0, 1):
        model_definitions[f"NonHal_Group_{i}"] = group
    for i, group in enumerate(groups_1, 1):
        model_definitions[f"Hal_Group_{i}"] = group

    # 상관관계 그룹에 포함된 모든 변수들을 단일 모델로도 테스트
    unique_features_in_groups = sorted(list(set(f for group in groups_0 + groups_1 for f in group)))
    for feature in unique_features_in_groups:
        model_name = f"Single_{shorten_species_name(feature).replace('. ', '_').replace(' ', '_')}"
        model_definitions[model_name] = [feature]


    print(f"\nStep 4: 총 {len(model_definitions)}개의 NGS 기반 모델 조합 생성 완료.")


    # --- 2. 회귀 분석을 위한 데이터 준비 ---
    ngs_cols = [c for c in analysis_ready_df.columns if c.startswith("NGS_MAPPED_")]
    # 원본 데이터의 실제 컬럼명을 반영하여 동적으로 찾기
    clinical_cols = [c for c in analysis_ready_df.columns if c.startswith(('Sex_', 'Smoking_', 'Oral hygiene_')) or c == 'Age']
    print(f"\n포함된 임상/인구통계 변수: {clinical_cols}")

    relevant_cols = TARGET_VARIABLES + ngs_cols + clinical_cols
    analysis_df = analysis_ready_df.dropna(subset=relevant_cols).copy()

    # X는 모든 예측 변수를 포함, y는 모든 결과 변수를 포함
    X = analysis_df[ngs_cols + clinical_cols]
    y_all = analysis_df[TARGET_VARIABLES]

    X_train, X_test, y_train_all, y_test_all = train_test_split(X, y_all, test_size=0.2, random_state=RANDOM_STATE)

    # --- 3. 메인 실행 루프 ---
    overall_results = []
    for target_var in TARGET_VARIABLES:
        print(f"\n{'='*25} Predicting Target: {target_var} {'='*25}")
        y_train, y_test = y_train_all[target_var], y_test_all[target_var]

        for name, microbe_features in model_definitions.items():
            print(f"\n--- Processing Model: {name} for {target_var} ---")

            # 각 모델 정의(미생물 그룹)에 공통 임상 변수를 추가
            current_features = microbe_features + clinical_cols

            # 1. 하이퍼파라미터 튜닝
            best_params = run_hyperparameter_tuning_cv(X_train, y_train, current_features, HYPERPARAMS_GRID)
            print(f"  > Best Params Found: {best_params}")

            # 2. 최종 모델 학습
            final_model, scaler = train_final_regression_model(X_train, y_train, current_features, best_params)

            # 3. 성능 평가
            metrics = evaluate_regression_model(final_model, scaler, X_test, y_test, current_features)

            result_row = {'Target_Variable': target_var, 'Model_Name': name, **metrics,
                          'Num_Features': len(current_features),
                          'Features_Summary': ", ".join(shorten_species_name(f) for f in current_features)}
            overall_results.append(result_row)

    # --- 4. 최종 결과 보고 ---
    print("\n\n--- 📊 최종 회귀 모델 성능 요약 ---")
    results_df = pd.DataFrame(overall_results).sort_values(by=['Target_Variable', 'R_squared'], ascending=[True, False])
    pd.set_option('display.width', 1000)
    print(results_df[['Target_Variable', 'Model_Name', 'R_squared', 'MAE', 'RMSE', 'Num_Features']].to_string(index=False, float_format="%.3f"))

    final_csv_path = os.path.join(OUTPUT_DIR, "regression_model_comparison_orig_logic.csv")
    results_df.to_csv(final_csv_path, index=False)
    print(f"\n최종 결과가 '{final_csv_path}' 파일로 저장되었습니다.")
