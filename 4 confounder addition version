    corr_matrix_0 = df_0[ngs_cols_for_corr].corr(method='pearson')
    corr_matrix_1 = df_1[ngs_cols_for_corr].corr(method='pearson')

    _plot_correlation_heatmap(corr_matrix_0, "NGS Correlation (Non-Halitosis Group)")
    _plot_correlation_heatmap(corr_matrix_1, "NGS Correlation (Halitosis Group)")
