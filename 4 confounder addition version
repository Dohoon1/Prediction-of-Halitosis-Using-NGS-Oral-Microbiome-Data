if __name__ == "__main__":
    start_time = time.time()
    # Step 1: 데이터 로드 및 전처리
    analysis_ready_df = load_and_preprocess_data(FILE_PATH)

    # Step 2: NGS 데이터만으로 상관관계 분석
    corr_0, corr_1 = analyze_and_plot_correlations(analysis_ready_df)
    
    # Step 3: NGS 데이터만으로 그룹 탐색
    groups_0, groups_1 = find_and_visualize_groups(corr_0, corr_1)

    # Step 4: 학습할 모델 정의 (기존 로직 유지)
    model_definitions = {}
    for i, group in enumerate(groups_0, 1):
        model_definitions[f"NonHal_Group_{i}"] = group
    for i, group in enumerate(groups_1, 1):
        model_definitions[f"Hal_Group_{i}"] = group

    # 상관관계 그룹에 포함된 모든 변수들을 단일 모델로도 테스트
    unique_features_in_groups = sorted(list(set(f for group in groups_0 + groups_1 for f in group)))
    for feature in unique_features_in_groups:
        model_name = f"Single_{shorten_species_name(feature).replace('. ', '_').replace(' ', '_')}"
        model_definitions[model_name] = [feature]

    print(f"\nStep 4: 총 {len(model_definitions)}개의 모델이 정의되었습니다.")

    # Step 5: 모델 학습 및 평가
    print("\nStep 5: 모델 학습 및 평가 시작...")

    # ✅ [수정] Feature Set을 명확히 분리하여 정의
    ngs_cols = [c for c in analysis_ready_df.columns if c.startswith("NGS_MAPPED_")]
    # 고정된 이름 대신, 접두사를 기반으로 동적으로 컬럼을 찾음
    demographic_cols = ['Age', 'Sex_M', 'Smoking_1']
    hygiene_cols = [c for c in analysis_ready_df.columns if c.startswith('Oral hygiene_')]

    # 실제 존재하는 컬럼들만 리스트에 포함
    clinical_cols = [c for c in (demographic_cols + hygiene_cols) if c in analysis_ready_df.columns]
    print(f"\n포함된 임상/인구통계 변수: {clinical_cols}")

    all_feature_cols = ngs_cols + clinical_cols # 학습 데이터(X)는 모든 feature를 포함해야 함

    X = analysis_ready_df[all_feature_cols]
    y = analysis_ready_df['Halitosis']
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y)


    all_model_results = []
    # ✅ [수정] 루프에서 미생물 feature와 임상 feature를 구분하여 전달
    for name, microbe_features in model_definitions.items():
        if not all(f in X.columns for f in microbe_features):
            print(f"Skipping model {name}: one or more features not found.")
            continue
        # train_and_evaluate_model 호출 시 clinical_cols를 추가로 전달
        result = train_and_evaluate_model(name, microbe_features, clinical_cols, X_train, y_train, X_test, y_test)
        result['Model_Name'] = name
        all_model_results.append(result)

    # Step 6: 최종 결과 정리 및 출력
    print("\n--- 최종 모델 성능 요약 ---")
    results_df = pd.DataFrame(all_model_results).sort_values(by="AUROC", ascending=False).reset_index(drop=True)
    pd.set_option('display.width', 1000)
    
    # ✅ [수정] 출력 컬럼에 'AUROC_95_CI' 추가
    cols_to_print = ['Model_Name', 'Num_Features', 'Accuracy(%)', 'AUROC', 'AUROC_95_CI', 'CV_AUROC', 'Features_Summary']
    print(results_df[cols_to_print].to_string(index=False, float_format="%.3f"))
    
    final_csv_path = os.path.join(OUTPUT_DIR, "final_model_comparison_results.csv")
    results_df.to_csv(final_csv_path, index=False)
    print(f"\n최종 결과가 '{final_csv_path}' 파일로 저장되었습니다.")
