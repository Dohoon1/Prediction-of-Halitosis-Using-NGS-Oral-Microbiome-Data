FILE_PATH = "PCR_NGS_Data.xlsx"
OUTPUT_DIR = "analysis_outputs_with_clinical_variables" 
CORRELATION_THRESHOLD = 0.6

HYPERPARAMS = {
    'lr': [0.1, 0.05, 0.01],
    'epochs': [500, 1000, 1500]
}
BATCH_SIZE = 16
K_FOLDS = 5
N_BOOTSTRAPS = 1000  # ✅ [추가] 95% CI 계산을 위한 부트스트랩 반복 횟수
RANDOM_STATE = 42

DEVICE = torch.device('cuda:0' if torch.cuda.is_available() else 'cpu')

